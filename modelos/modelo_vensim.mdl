{UTF-8}
Constante Evaporacion=0.5
	~	
	~		|

Flujo Riego=IF THEN ELSE( Modo Operacion = 2 :AND: Nivel Humedad Suelo < Umbral App ,\
		 20 , 0 )
	~	
	~		|

Modo Operacion=2
	~	
	~		|

Nivel Humedad Suelo=A FUNCTION OF(Nivel Humedad Suelo,Tasa Secado) ~~|
Nivel Humedad Suelo= INTEG (Flujo Riego - Tasa Secado,
		100)
	~	
	~		|

Tasa Secado=A FUNCTION OF(Tasa Secado,Constante Evaporacion,Temp DHT11) ~~|
Tasa Secado=Constante Evaporacion * Temp DHT11 * (Nivel Humedad Suelo / 100)
	~	
	~		|

Temp DHT11=28
	~	
	~		|

Umbral App=80
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

